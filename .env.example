NODE_ENV=development
HOST=0.0.0.0
PORT=8081

# Identity persistence
MONGODB_URI=
MONGODB_DATABASE=foodpulse_identity

# Sessions, rate limits, and authorization cache
REDIS_URL=

# Comma-separated Kafka bootstrap servers
KAFKA_BROKERS=127.0.0.1:19092
KAFKA_CLIENT_ID=identity-service

# Shared AWS configuration
AWS_PROFILE=foodpulse
AWS_REGION=ap-south-1

# Optional for local development. Prefer an AWS profile locally and an IAM role in AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Cognito user pool and server-side app client
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=

# Identity-owned profile/avatar assets
AWS_S3_DEFAULT_BUCKET=
